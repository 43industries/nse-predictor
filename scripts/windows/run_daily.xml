<?xml version="1.0" encoding="UTF-16"?>
<!--
  Import in Windows Task Scheduler (Task Scheduler Library → Import Task…).
  Edit WorkingDirectory / Command to match your install path and venv python.
  Default: weekdays 17:30 local time.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>NSE Predictor daily collect → ingest → QA → score → monitor</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T17:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\Marllone.Mayieka\Desktop\nse predictor\.venv\Scripts\python.exe</Command>
      <Arguments>scripts\run_daily.py</Arguments>
      <WorkingDirectory>C:\Users\Marllone.Mayieka\Desktop\nse predictor</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
